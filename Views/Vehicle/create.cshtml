@model MotorShift_Rentals.Models.VehicleModel

@{
    ViewData["Title"] = "Add Vehicle";
}

<h1>Add Vehicle</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <h4>Identity</h4>
            <div class="form-group mb-3">
                <label asp-for="Make" class="control-label"></label>
                <select asp-for="Make" class="form-control"
                        asp-items="Html.GetEnumSelectList<MotorShift_Rentals.Enums.VehicleMake>()">
                </select>
                <span asp-validation-for="Make" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Year" class="control-label"></label>
                <input asp-for="Year" class="form-control" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>

            <h4>Specs</h4>
            <div class="form-group mb-3">
                <label asp-for="Mileage" class="control-label"></label>
                <input asp-for="Mileage" class="form-control" />
                <span asp-validation-for="Mileage" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FuelType" class="control-label"></label>
                <select asp-for="FuelType" class="form-control"
                        asp-items="Html.GetEnumSelectList<MotorShift_Rentals.Models.FuelType>()">
                </select>
                <span asp-validation-for="FuelType" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Transmission" class="control-label"></label>
                <select asp-for="Transmission" class="form-control"
                        asp-items="Html.GetEnumSelectList<MotorShift_Rentals.Models.TransmissionType>()">
                </select>
                <span asp-validation-for="Transmission" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BodyType" class="control-label"></label>
                <select asp-for="BodyType" class="form-control"
                        asp-items="Html.GetEnumSelectList<MotorShift_Rentals.Models.BodyType>()">
                </select>
                <span asp-validation-for="BodyType" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EngineSizeLiters" class="control-label"></label>
                <input asp-for="EngineSizeLiters" class="form-control" />
                <span asp-validation-for="EngineSizeLiters" class="text-danger"></span>
            </div>

            <h4>Financial</h4>
            <div class="form-group mb-3">
                <label asp-for="AskingPrice" class="control-label"></label>
                <input asp-for="AskingPrice" class="form-control" />
                <span asp-validation-for="AskingPrice" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EstimatedMonthlyInsurance" class="control-label"></label>
                <input asp-for="EstimatedMonthlyInsurance" class="form-control" />
                <span asp-validation-for="EstimatedMonthlyInsurance" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EstimatedMonthlyMaintenanceCost" class="control-label"></label>
                <input asp-for="EstimatedMonthlyMaintenanceCost" class="form-control" />
                <span asp-validation-for="EstimatedMonthlyMaintenanceCost" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EstiatedMontlyTracker" class="control-label"></label>
                <input asp-for="EstiatedMontlyTracker" class="form-control" />
                <span asp-validation-for="EstiatedMontlyTracker" class="text-danger"></span>
            </div>

            <h4>Condition &amp; History</h4>
            <div class="form-group mb-3">
                <label asp-for="TitleStatus" class="control-label"></label>
                <select asp-for="TitleStatus" class="form-control"
                        asp-items="Html.GetEnumSelectList<MotorShift_Rentals.Models.TitleStatus>()">
                </select>
                <span asp-validation-for="TitleStatus" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NumberOfPreviousOwners" class="control-label"></label>
                <input asp-for="NumberOfPreviousOwners" class="form-control" />
                <span asp-validation-for="NumberOfPreviousOwners" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="HasAccidentHistory" class="form-check-input" />
                <label asp-for="HasAccidentHistory" class="form-check-label"></label>
            </div>

            <div class="form-check mb-3">
                <input asp-for="HasOutstandingLiens" class="form-check-input" />
                <label asp-for="HasOutstandingLiens" class="form-check-label"></label>
            </div>

            <div class="form-check mb-3">
                <input asp-for="ServiceHistoryAvailable" class="form-check-input" />
                <label asp-for="ServiceHistoryAvailable" class="form-check-label"></label>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LastServiceDate" class="control-label"></label>
                <input asp-for="LastServiceDate" class="form-control" type="date" />
                <span asp-validation-for="LastServiceDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LastInspectionDate" class="control-label"></label>
                <input asp-for="LastInspectionDate" class="form-control" type="date" />
                <span asp-validation-for="LastInspectionDate" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="PassedLastInspection" class="form-check-input" />
                <label asp-for="PassedLastInspection" class="form-check-label"></label>
            </div>

            <h4>Legal / Compliance</h4>
            <div class="form-check mb-3">
                <input asp-for="IsRegistered" class="form-check-input" />
                <label asp-for="IsRegistered" class="form-check-label"></label>
            </div>

            <div class="form-group mb-3">
                <label asp-for="RegistrationExpiry" class="control-label"></label>
                <input asp-for="RegistrationExpiry" class="form-control" type="date" />
                <span asp-validation-for="RegistrationExpiry" class="text-danger"></span>
            </div>

            <h4>Warranty</h4>
            <div class="form-check mb-3">
                <input asp-for="HasActiveWarranty" class="form-check-input" />
                <label asp-for="HasActiveWarranty" class="form-check-label"></label>
            </div>

            <div class="form-group mb-3">
                <label asp-for="WarrantyExpiryDate" class="control-label"></label>
                <input asp-for="WarrantyExpiryDate" class="form-control" type="date" />
                <span asp-validation-for="WarrantyExpiryDate" class="text-danger"></span>
            </div>

            <h4>Notes</h4>
            <div class="form-group mb-3">
                <label asp-for="InspectorNotes" class="control-label"></label>
                <textarea asp-for="InspectorNotes" class="form-control" rows="4"></textarea>
                <span asp-validation-for="InspectorNotes" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save Vehicle" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}